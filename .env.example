# Production seeds are blocked unless this is explicitly set to true.
ALLOW_PRODUCTION_SEED=false
UPLOAD_DIR=uploads
EVIDENCE_RETENTION_DAYS=365
EMERGENCY_RETENTION_DAYS=90
MAX_EMERGENCY_STREAM_BYTES=262144000
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
